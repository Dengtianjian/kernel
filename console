#!/usr/bin/env php
<?php

/**
 * 内核 CLI 入口
 * 用法：php kernel/console <command> [options] [arguments]
 * 例如：php kernel/console --help
 */

//* 定位 autoload：优先内核目录下的 vendor，其次项目根目录 vendor
$kernelVendor = __DIR__ . "/vendor/autoload.php";
$rootVendor = dirname(__DIR__) . "/vendor/autoload.php";

if (file_exists($kernelVendor)) {
  include_once($kernelVendor);
} elseif (file_exists($rootVendor)) {
  include_once($rootVendor);
} else {
  fwrite(STDERR, "autoload.php not found. Please run composer install.\n");
  exit(1);
}

use kernel\Foundation\Console\Console;
use kernel\Setup\Console\Bootstrap;

//* 命令由 Console 统一注册（不再经 Router），CLI 按命令名分发，不解析 URI（Request 的 URI 即命令名）
$console = new Console("kernel");

//* 应用装配：注册内核命令（setup() 必须在 run() 之前调用）
$console->setup(Bootstrap::class);

//* 执行命令分发，并以退出码结束（Console::run 内部调用 handle 后 exit）
$console->run();
